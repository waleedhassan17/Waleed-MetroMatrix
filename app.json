{
  "expo": {
    "name": "MetroMatrix",
    "slug": "MetroMatrix",
    "owner": "waleed17",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waleed17.MetroMatrix",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.942315940095-h2cnrp1f9o3gji37a6e988c5upvbqjno"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "fb26818541697736156"
            ]
          }
        ],
        "FacebookAppID": "26818541697736156",
        "FacebookDisplayName": "MetroMatrix",
        "LSApplicationQueriesSchemes": [
          "fbapi",
          "fb-messenger-share-api",
          "fbauth2",
          "fbshareextension"
        ],
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ],
        "NSCameraUsageDescription": "MetroMatrix uses your camera for video consultations with your doctor.",
        "NSMicrophoneUsageDescription": "MetroMatrix uses your microphone so you can talk to your service provider or doctor during an in-app call.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.metromatrix.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.DISABLE_KEYGUARD"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "metromatrix",
    "facebookScheme": "fb26818541697736156",
    "facebookAppId": "26818541697736156",
    "facebookDisplayName": "MetroMatrix",
    "facebookAutoLogAppEventsEnabled": false,
    "facebookAdvertiserIDCollectionEnabled": false,
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "react-native-fbsdk-next",
        {
          "appID": "26818541697736156",
          "clientToken": "8e9ceae58a1d76247a99d80f3bf77403",
          "displayName": "MetroMatrix",
          "scheme": "fb26818541697736156",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MetroMatrix uses your photos so you can attach health records and prescriptions.",
          "cameraPermission": "MetroMatrix uses your camera so you can photograph health records and prescriptions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification/notification-icon.png",
          "color": "#2563EB",
          "defaultChannel": "messages",
          "sounds": [
            "./assets/sounds/ringtone.wav"
          ]
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "adc7a05f-37ba-41dc-a337-628f7ac9226f"
      }
    }
  }
}
